# Defaults run the fully local demo. Never use demo mode for real advertising.
APP_MODE=demo
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Optional URL prefix. Set the same value during the frontend build and at runtime.
APP_BASE_PATH=
DATA_FILE=.data/demo.json
# Production: APP_MODE=live, NODE_ENV=production, APP_ORIGIN=https://your-domain
# MongoDB replica set is required for transactional approval/budget reservations.
MONGODB_URI=mongodb://localhost:27017/bd_ads?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Local planning can start without Redis when false; production/paid execution require true.
BACKGROUND_JOBS_ENABLED=true
# Generate each separately with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
MCP_SERVICE_KEY=
LIVE_EXECUTION_ENABLED=false
# Explicitly choose a currently supported Meta API version after checking changelog.
META_API_VERSION=v26.0
# Set through Integrations after signing in: Meta token, ad account, Page, pixel.
# Optional generic HTTPS endpoint accepting {task,context} and returning validated JSON.
# Never expose this key or endpoint through VITE_ variables.
LLM_PROVIDER=demo
LLM_ENDPOINT=
LLM_API_KEY=
TRUST_PROXY=0
META_APP_ID=
META_APP_SECRET=
# Optional local bootstrap inputs, imported into encrypted integration storage.
META_ACCESS_TOKEN=
META_EXPLORER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
LLM_MODEL=gemini-3.1-flash-lite
LLM_RESEARCH_MODEL=gemini-3-flash-preview
LLM_RESEARCH_THINKING=high
GEMINI_SEARCH_GROUNDING=false
# OpenAI: LLM_PROVIDER=openai, LLM_ENDPOINT=https://api.openai.com/v1,
# LLM_MODEL=gpt-6-luna, LLM_RESEARCH_MODEL=gpt-6-luna. Accounts stores each workspace's key.
# Search and API reasoning consume paid usage; no automatic provider/model fallback.
LLM_SEARCH_GROUNDING=false
# REST credentials are independent of REDIS_URL. BullMQ needs the TCP/TLS URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Files stay private to each workspace. Use S3-compatible storage or a persistent volume in production.
STORAGE_DRIVER=local
STORAGE_PATH=.data/uploads
STORAGE_PERSISTENT=false
S3_BUCKET=
S3_ENDPOINT=
# Cloudflare R2: account S3 endpoint, region auto, private bucket.
# Map R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY to the S3 variables below.
# Authenticated file proxy requires no public bucket URL or expiring public link.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LLM_ALLOWED_GATEWAY_HOSTS=
